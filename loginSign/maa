<VirtualHost *:80>
    ServerAdmin admin@maa-domain.com
    ServerName maa.mara
    ServerAlias www.maamara.com

    DocumentRoot /home/oopondo/Documents/loggin_django/loginSign

    ErrorLog ${APACHE_LOG_DIR}/error.log
    CustomLog ${APACHE_LOG_DIR}/access.log combined

    Alias /static /home/oopondo/Documents/loggin_django/loginSign//static
    <Directory /home/oopondo/Documents/loggin_django/loginSign/static>
        Require all granted
    </Directory>

    Alias /media /home/oopondo/Documents/loggin_django/loginSign/media
    <Directory /home/oopondo/Documents/loggin_django/loginSign/media>
        Require all granted
    </Directory>

    <Directory /home/oopondo/Documents/loggin_django/loginSign>
        <Files wsgi.py>
            Require all granted
        </Files>
    </Directory>

    WSGIDaemonProcess your_app python-path=/home/oopondo/Documents/loggin_django/loginSign python-home=/home/oopondo/Documents/loggin_django/loginSign/venv
    WSGIProcessGroup loginSign
    WSGIScriptAlias / /home/oopondo/Documents/loggin_django/loginSign/loginSign/wsgi.py
</VirtualHost>
