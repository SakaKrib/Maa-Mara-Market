# Development example for GitHub's Tailscale-backed native test build.
# Production builds should set VITE_API_URL=https://maamaramarket.com instead.
# Never put secrets in VITE_* variables.
VITE_BUILD_TARGET=mobile
VITE_API_URL=http://100.109.224.0:8000
# Public storefront origin used when sharing product links from a native WebView.
# Confirm this domain is the live storefront before release.
VITE_PUBLIC_SITE_URL=https://maamaramarket.com
