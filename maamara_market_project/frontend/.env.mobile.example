# Copy to .env.mobile for a native production build and set the API origin
# to the public HTTPS origin that actually serves the Maa Mara Market API.
# This example assumes the API shares the website origin; change it if hosting
# separates the frontend and API. Never put secrets in VITE_* variables.
VITE_BUILD_TARGET=mobile
VITE_API_URL=https://maamaramarket.com
