# Copy this file to maamara_market_project/.env on the production host.
# Keep real credentials out of Git. Django secrets belong in backend/project01/.env.

DEBUG=False
FRONTEND_URL=https://maamaramarket.com
BACKEND_URL=https://maamaramarket.com
ALLOWED_HOSTS=maamaramarket.com,www.maamaramarket.com
CORS_ALLOWED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com
CSRF_TRUSTED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
ACME_EMAIL=YOUR_CERTIFICATE_EMAIL
