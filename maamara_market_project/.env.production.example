# Copy this file to maamara_market_project/.env on the production host.
# Keep real credentials out of Git. Django secrets belong in backend/project01/.env.

DEBUG=False
FRONTEND_URL=https://maamaramarket.com
BACKEND_URL=https://maamaramarket.com
ALLOWED_HOSTS=maamaramarket.com,www.maamaramarket.com
CORS_ALLOWED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com
CSRF_TRUSTED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
ACME_EMAIL=YOUR_CERTIFICATE_EMAIL

# M-Pesa merchant payouts (required only for vendor Till/Buy Goods and PayBill payouts).
# Use the Daraja B2B endpoint for the correct environment; never point this at the B2C URL.
MPESA_B2B_URL=https://api.safaricom.co.ke/mpesa/b2b/v1/paymentrequest
MPESA_B2B_SHORT_CODE=YOUR_AUTHORIZED_SENDER_SHORTCODE
MPESA_B2B_INITIATOR_NAME=YOUR_B2B_API_INITIATOR
MPESA_B2B_INITIATOR_PASSWORD=YOUR_B2B_INITIATOR_PASSWORD
MPESA_B2B_CERTIFICATE_PATH=/app/perm/your-safaricom-certificate.cer
MPESA_B2B_RESULT_URL=https://maamaramarket.com/vendorDashboard/mpesa/result
MPESA_B2B_TIMEOUT_URL=https://maamaramarket.com/vendorDashboard/mpesa/timeout
