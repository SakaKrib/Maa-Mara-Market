maamaramarket.com, www.maamaramarket.com {
    encode gzip

    @websocket {
        path /ws/*
    }

    handle @websocket {
        reverse_proxy backend:8000
    }

    handle /.well-known/assetlinks.json {
        reverse_proxy backend:8000
    }

    handle /.well-known/apple-app-site-association {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
