# Maa Mara Market production environment template
# Copy this template to backend/project01/.env on the production server.
# Docker Compose also reads maamara_market_project/.env; use .env.production.example there.
# Never commit real credentials.

DEBUG=False

FRONTEND_URL=https://maamaramarket.com
BACKEND_URL=https://maamaramarket.com

ALLOWED_HOSTS=maamaramarket.com,www.maamaramarket.com
CORS_ALLOWED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com
CSRF_TRUSTED_ORIGINS=https://maamaramarket.com,https://www.maamaramarket.com

SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Docker Compose interpolation / Caddy certificate contact
ACME_EMAIL=YOUR_CERTIFICATE_EMAIL

POSTGRES_DB=maamara_db
POSTGRES_USER=maamara_user
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Native push delivery requires a Firebase service-account credential on the BACKEND.
# Set ONE of the following in the real backend/project01/.env (never commit real values):
# FIREBASE_SERVICE_ACCOUNT_JSON={\"type\":\"service_account\",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# Android/iOS google-services.json / GoogleService-Info.plist do NOT replace this credential.

# Google Identity Services + native Google Sign-In.
# GOOGLE_CLIENT_ID is the Web OAuth client ID used for GIS and Django ID-token audience verification.
# GOOGLE_CLIENT_SECRET is retained for compatibility but is not used by the ID-token exchange.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# iOS OAuth client ID for the native Google plugin.
GOOGLE_IOS_CLIENT_ID=
# Android OAuth client ID is registered in Google Cloud for package com.maamaramarket.app
# and the release signing SHA-1. The native plugin uses the Web client ID for token exchange.
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple. APPLE_CLIENT_ID is the Services ID for the website.
# Native iOS identity-token audience is APPLE_BUNDLE_ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.maamaramarket.app
# Mount the Apple AuthKey_*.p8 file outside the repository.
APPLE_PRIVATE_KEY_PATH=/run/secrets/maamara-apple-signin-key.p8
# Must exactly match the Return URL registered for APPLE_CLIENT_ID.
# Shared-hostname testing uses /maamara/api/apple/callback/; root deployment omits /maamara.
APPLE_REDIRECT_URI=https://maamaramarket.com/maamara/api/apple/callback/

# Keep the remainder of your existing payment, email, OAuth,
# shipping, exchange-rate and AI credentials in this file.
